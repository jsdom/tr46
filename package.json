{
  "name": "tr46",
  "version": "7.0.0",
  "description": "An implementation of the Unicode UTS #46: Unicode IDNA Compatibility Processing",
  "keywords": [
    "punycode",
    "tr46",
    "unicode",
    "url",
    "uts46",
    "whatwg"
  ],
  "license": "MIT",
  "author": "Sebastian Mayr <npm@smayr.name>",
  "contributors": [
    "Timothy Gu <timothygu99@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsdom/tr46.git"
  },
  "files": [
    "index.js",
    "lib/"
  ],
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "check": "npm run lint && npm run fmt:check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "node scripts/generate-mapping-table.mjs && node scripts/generate-regexes.mjs",
    "pretest": "node scripts/get-latest-tests.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "punycode": "^2.3.1"
  },
  "devDependencies": {
    "@domenic/eslint-config": "^6.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@unicode/unicode-18.0.0": "^2.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "oxfmt": "0.75.0",
    "regenerate": "^1.5.0"
  },
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  },
  "unicodeVersion": "18.0.0"
}
